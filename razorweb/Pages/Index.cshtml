@page
@model IndexModel
@{
    ViewData["Title"] = "Tareas Asignadas";
    var filtroEstado = ViewData["filtroEstado"] as string ?? "todos";
    var busqueda = ViewData["busqueda"] as string ?? "";
}

<div class="text-center mb-4">

    <div class="d-flex justify-content-center align-items-center mb-3 gap-3">
        <form method="get" class="d-flex">
            <input type="text" name="busqueda" value="@busqueda" class="form-control me-2" placeholder="Buscar tarea..." style="width: 300px;" />
            <input type="hidden" name="filtroEstado" value="@filtroEstado" />
            <button type="submit" class="btn btn-primary">Buscar</button>
        </form>

        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#crearTareaModal">
            <i class="fas fa-plus me-1"></i> Crear Tarea
        </button>
    </div>

    <div class="btn-group mb-3" role="group">
        <a asp-page="./Index" asp-route-busqueda="@busqueda" asp-route-filtroEstado="todos"
           class="btn @(filtroEstado == "todos" ? "btn-primary" : "btn-outline-primary")">
            Todas
        </a>
        <a asp-page="./Index" asp-route-busqueda="@busqueda" asp-route-filtroEstado="pendiente"
           class="btn @(filtroEstado == "pendiente" ? "btn-primary" : "btn-outline-primary")">
            Pendientes
        </a>
        <a asp-page="./Index" asp-route-busqueda="@busqueda" asp-route-filtroEstado="en-curso"
           class="btn @(filtroEstado == "en-curso" ? "btn-primary" : "btn-outline-primary")">
            En curso
        </a>
    </div>
</div>

<div class="grid-container index-grid">
    <div class="grid-item"><b>Nombre Tarea</b></div>
    <div class="grid-item"><b>Fecha Vencimiento</b></div>
    <div class="grid-item"><b>Estado</b></div>
    <div class="grid-item"><b>Acciones</b></div>

    @foreach (var tarea in Model.Tareas)
    {
        <div class="grid-item">@tarea.nombreTarea</div>
        <div class="grid-item">@tarea.fechaVencimiento</div>
        <div class="grid-item">
            <span class="badge @(tarea.estado switch
            {
                "Pendiente" => "bg-warning text-dark",
                "En curso" => "bg-info",
                "Finalizado" => "bg-success",
                "Cancelado" => "bg-danger",
                _ => "bg-secondary"
            })">
                @tarea.estado
            </span>
        </div>
        <div class="grid-item">
            <form method="post" class="d-flex gap-2">
                <input type="hidden" name="nombreTarea" value="@tarea.nombreTarea" />
                <button type="submit" asp-page-handler="Concluir" class="btn btn-success btn-sm">Concluir</button>
                <button type="submit" asp-page-handler="Cancelar" class="btn btn-danger btn-sm">Cancelar</button>
            </form>
        </div>
    }

    @if (!Model.Tareas.Any())
    {
        <div class="text-muted" style="grid-column: 1 / -1;">
            No hay tareas asignadas
        </div>
    }
</div>

<nav>
    <ul class="pagination justify-content-center">
        @for (int i = 1; i <= Model.TotalPaginas; i++)
        {
            <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                <a class="page-link" asp-page="./Index" asp-route-pagina="@i"
                   asp-route-busqueda="@busqueda" asp-route-filtroEstado="@filtroEstado">
                    @i
                </a>
            </li>
        }
    </ul>
</nav>

<div class="modal fade" id="crearTareaModal" tabindex="-1" aria-labelledby="crearTareaModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="crearTareaModalLabel">
                    <i class="fas fa-plus-circle me-2"></i>Nueva Tarea
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="CrearTarea">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="nombreTarea" class="form-label">Nombre de la Tarea <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="nombreTarea" name="nombreTarea" required
                               placeholder="Ej: Llamar al dentista">
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="fechaVencimiento" class="form-label">Fecha de Vencimiento <span class="text-danger">*</span></label>
                                <input type="date" class="form-control" id="fechaVencimiento" name="fechaVencimiento" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label for="estado" class="form-label">Estado <span class="text-danger">*</span></label>
                                <select class="form-select" id="estado" name="estado" required>
                                    <option value="Pendiente" selected>Pendiente</option>
                                    <option value="En curso">En curso</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-1"></i>Cancelar
                    </button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save me-1"></i>Crear Tarea
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>